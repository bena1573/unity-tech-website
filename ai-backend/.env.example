# Which LLM provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Only one of these is required, matching LLM_PROVIDER above
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default model
# Anthropic default: claude-sonnet-4-6
# OpenAI default: gpt-4o-mini
LLM_MODEL=

# Comma-separated list of origins allowed to call this API (your website domain)
ALLOWED_ORIGINS=https://unitytech.io,http://localhost:5500

# Server port
PORT=8787

# Max chat messages per IP per minute (protects your LLM budget from abuse)
CHAT_RATE_LIMIT_PER_MIN=8
